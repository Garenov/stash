# Локально — файл SQLite. Для Turso: libsql://your-db.turso.io
DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Сгенерировать: openssl rand -base64 32   (или через node, см. README)
# Из него же выводятся ключи шифрования 2FA-секретов и подписи токенов.
# Смена AUTH_SECRET делает уже настроенную 2FA нерабочей.
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# --- OAuth (необязательно: кнопка появляется, только если заданы оба значения) ---
# Callback URL у провайдера: <ваш-домен>/api/auth/callback/<github|google|discord>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Защита от ботов: Cloudflare Turnstile (необязательно) ---
# Тестовые ключи для dev, всегда проходят: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Фоновая проверка ссылок (Vercel Cron передаёт его как Bearer) ---
CRON_SECRET=
